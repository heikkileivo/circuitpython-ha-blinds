CIRCUITPY_WIFI_SSID = "your_wifi_ssid"
CIRCUITPY_WIFI_PASSWORD = "your_wifi_password"
CIRCUITPY_WEB_API_PASSWORD = "your_web_api_password"
CIRCUITPY_WEB_API_PORT = 80
CIRCUITPY_WEB_INSTANCE_NAME = "electricity-meter"

# Optional. The device's name on the network: what the router's client list
# shows and what mDNS answers to. Letters, digits and hyphens only, 32 bytes
# at most.
#
# It has to be CIRCUITPY_WIFI_HOSTNAME, which needs CircuitPython 10.3.0 or
# later, and it only takes effect after a full reboot - reloading code.py is
# not enough, because the web workflow's association survives a reload.
# Setting wifi.radio.hostname from code.py cannot work: the firmware brings
# WiFi up itself at boot, before code.py runs, and ESP-IDF only reflects a
# hostname change at the next reassociation, not on the lease in hand.
#
# Left unset, CircuitPython uses cpy-<board id>-<mac> trimmed to 32 bytes,
# which on a TinyS3 is cpy-edmaker_tinys3-<mac>. That is already unique per
# board, so this setting is cosmetic. (Through 9.1.x the default was the
# board's own UMTinyS3, which every TinyS3 shared - hence DHCP reservations
# by MAC, which stay correct either way.)
# CIRCUITPY_WIFI_HOSTNAME = "electricity-meter"

device_name = "Electricity Meter"
counter_name = "electricity"
sensor_pin = "board.D2"
pulses_per_unit = 1000
report_interval = 5
ring_buffer_length = 30
debounce_time_ms = 10
total_value_multiplier = 1
power_dividend = 3600000

mqtt_broker = "192.168.1.36"
mqtt_port = 1883
mqtt_user = "your_mqtt_user"
mqtt_pwd = "your_mqtt_password"
