CIRCUITPY_WIFI_SSID = "your_wifi_ssid"
CIRCUITPY_WIFI_PASSWORD = "your_wifi_password"
CIRCUITPY_WEB_API_PASSWORD = "your_web_api_password"
CIRCUITPY_WEB_API_PORT = 80
CIRCUITPY_WEB_INSTANCE_NAME = "water-meter"

device_name = "Water Meter"
counter_name = "water"
sensor_pin = "board.D2"
pulses_per_unit = 1
report_interval = 60
ring_buffer_length = 30
debounce_time_ms = 10
total_value_multiplier = 1

mqtt_broker = "192.168.1.36"
mqtt_port = 1883
mqtt_user = "your_mqtt_user"
mqtt_pwd = "your_mqtt_password"
