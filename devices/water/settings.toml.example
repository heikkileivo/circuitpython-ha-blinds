CIRCUITPY_WIFI_SSID = "your_wifi_ssid"
CIRCUITPY_WIFI_PASSWORD = "your_wifi_password"
CIRCUITPY_WEB_API_PASSWORD = "your_web_api_password"
CIRCUITPY_WEB_API_PORT = 80
CIRCUITPY_WEB_INSTANCE_NAME = "water-meter"

# Optional. The device's name on the network: what the router's client list
# shows and what mDNS answers to. Letters, digits and hyphens only. Without
# it CircuitPython picks one: through 9.1.x each board derives its own from
# the chip, such as cpy-4fa480, but from 9.2.0 every Espressif board defaults
# to "espressif", so all five would share a name. Read on every version the
# fleet runs, unlike CIRCUITPY_WIFI_HOSTNAME, which needs 10.3.0.
# hostname = "water-meter"

device_name = "Water Meter"
counter_name = "water"
sensor_pin = "board.D1"              # ANALOG output from the optical pickup
pulses_per_unit = 81                  # calibrated against known volumes (both edges per vane)
report_interval = 60

# Adaptive Schmitt parameters (see devices/water/schmitt.py); defaults in
# code.py are the validated values, override only if needed.
# NOTE: CircuitPython settings.toml only accepts strings and integers, NOT
# float literals -- quote percent values as strings if you set them here.
min_swing_pct = "1.5"                 # gate floor: parked ~0.5%, flow ~2.5% (sensor LED painted out)
hyst_pct = "1.0"                      # Schmitt hysteresis around the envelope midpoint
env_ms = 4500                         # rolling envelope window (>= 1 rotation period)
sub_window_ms = 250
sample_ms = 2
oversample = 4

mqtt_broker = "192.168.1.36"
mqtt_port = 1883
mqtt_user = "your_mqtt_user"
mqtt_pwd = "your_mqtt_password"
