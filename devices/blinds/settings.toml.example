CIRCUITPY_WIFI_SSID = "your_wifi_ssid"
CIRCUITPY_WIFI_PASSWORD = "your_wifi_password"
CIRCUITPY_WEB_API_PASSWORD = "your_web_api_password"
CIRCUITPY_WEB_API_PORT = 80
CIRCUITPY_WEB_INSTANCE_NAME = "upstairs-living-room-right-blinds"

device_name = "Upstairs Living Room Right Blinds"
tilt_scale = 10.0

# A move slows to its approach speed within its approach revolutions of the
# end, by travel. With the travel unknown, after an interrupted move or with a
# blank NVM, it runs at approach speed all the way, until an end sensor
# re-anchors the travel.
close_approach_revs = 5
open_approach_revs = 5
open_approach_speed = 500
close_approach_speed = 300
# Optional. Until full travel is learned from a run from one end sensor to
# the other, window_height / (spindle_diameter * pi) stands in for it, both in
# millimetres; defaults 1800 and 20. A move stops once its travel is
# travel_margin_revs past its end; default 2. It gives up after open_timeout
# or close_timeout seconds, default 45, or approach_timeout, default 120, with
# the travel unknown.
# window_height = 1800
# spindle_diameter = 20
# travel_margin_revs = 2
# open_timeout = 45
# close_timeout = 45
# approach_timeout = 120
# Optional. A move that reached its end sensor but stopped past its zone
# re-seats: it crawls back at approach speed until the sensor is active, at
# most re_seat_revs revolutions. An open that may rest at the top off its up
# end sensor first crawls down at most crawl_down_revs revolutions looking for
# it; if it doesn't find it, the blind was below, and it crawls up to it. A
# crawl down or re-seat gives up after crawl_timeout seconds. Defaults 1, 1
# and 15; quote a fraction, such as "0.8".
# re_seat_revs = 1
# crawl_down_revs = 1
# crawl_timeout = 15
# Optional. How often the lift's servo angle is sampled during a move, in
# milliseconds; default 50.
# lift_sample_ms = 50
# Optional. The stall stop: the lift has stalled when, at a commanded duty,
# its speed stays at most stall_max_speed counts/s and its servo angle within
# stall_max_angle_change counts for stall_window_ms. A duty command gets
# stall_grace_ms to start the servo first. Defaults 150, 20, 5 and 300.
# In the pot's dead zone at the wrap, where the servo angle holds while the
# servo turns, the window is stall_dead_zone_window_ms at duty 800 and
# 800 / |duty| times that at other duties, never less than stall_window_ms;
# default 200.
# stall_window_ms = 150
# stall_max_speed = 20
# stall_max_angle_change = 5
# stall_grace_ms = 300
# stall_dead_zone_window_ms = 200
# Optional. Deadlines on the servo waits, in milliseconds: the lift servo gets
# lift_start_deadline_ms to start moving and lift_stop_deadline_ms to stop,
# and the tilt servo tilt_deadline_ms to arrive. A tilt servo that doesn't
# report MOVING within tilt_rise_ms of the command was at its goal already.
# Defaults 2000, 2000, 3000 and 100.
# lift_start_deadline_ms = 2000
# lift_stop_deadline_ms = 2000
# tilt_deadline_ms = 3000
# tilt_rise_ms = 100

mqtt_broker = "192.168.1.36"
mqtt_port = 1883
mqtt_user = "your_mqtt_user"
mqtt_pwd = "your_mqtt_password"

# Optional. The MQTT socket and loop() timeout, in seconds; default 0.25.
# settings.toml takes no floats, so write 1, or quote a fraction: "0.5".
# mqtt_socket_timeout = 1
# Optional. Rebuild the MQTT client after this many seconds of listening with
# no echo of the blind's own uptime; default 45.
# mqtt_echo_timeout = 45
# Optional. Restart once the blind has heard no echo of its own uptime for
# this many seconds, as soon as it isn't moving; default 300.
# mqtt_escalation_s = 300
# Optional. Restart after this many failed runs of main() in a row, each
# shorter than mqtt_escalation_s; default 3.
# restart_loop_max = 3
